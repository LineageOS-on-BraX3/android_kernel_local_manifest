<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote fetch="https://github.com/LineageOS-on-BraX3" name="github"/>
  <remote fetch="https://android.googlesource.com" name="aosp"/>

  <!-- Remove unused Android Common Kernel projects -->
  <remove-project name="kernel/common"/>
  <remove-project name="kernel/common-modules/virtual-device"/>

  <!-- Track libudft from AOSP -->
  <project remote="aosp" name="platform/system/libufdt" path="system/libufdt" revision="android13-release"/>

  <!-- Track BraX3 kernel projects -->
  <project remote="github" name="android_kernel_brax_mt6835" path="kernel-5.15">
    <linkfile src="build.config.mtk.aarch64.mgk" dest="build.config" />
  </project>
  <project remote="github" name="android_vendor_mediatek_kernel_modules_connectivity_bt_mt66xx" path="vendor/mediatek/kernel_modules/connectivity/bt/mt66xx"/>
  <project remote="github" name="android_vendor_mediatek_kernel_modules_connectivity_common" path="vendor/mediatek/kernel_modules/connectivity/common"/>
  <project remote="github" name="android_vendor_mediatek_kernel_modules_connectivity_connfem" path="vendor/mediatek/kernel_modules/connectivity/connfem"/>
  <project remote="github" name="android_vendor_mediatek_kernel_modules_connectivity_fmradio" path="vendor/mediatek/kernel_modules/connectivity/fmradio"/>
  <project remote="github" name="android_vendor_mediatek_kernel_modules_connectivity_gps" path="vendor/mediatek/kernel_modules/connectivity/gps"/>
  <project remote="github" name="android_vendor_mediatek_kernel_modules_connectivity_wlan_adaptor" path="vendor/mediatek/kernel_modules/connectivity/wlan/adaptor"/>
  <project remote="github" name="android_vendor_mediatek_kernel_modules_connectivity_wlan_core_gen4m" path="vendor/mediatek/kernel_modules/connectivity/wlan/core/gen4m"/>
  <project remote="github" name="android_vendor_mediatek_kernel_modules_gpu" path="vendor/mediatek/kernel_modules/gpu"/>
</manifest>
